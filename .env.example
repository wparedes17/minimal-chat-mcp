# Required: URL of your MCP server (same value used in Windsurf's serverUrl)
MCP_SERVER_URL=https://myhost:8080/mcp

# Optional: MCP transport type — streamable_http (default) or sse
MCP_TRANSPORT=streamable_http

# Optional: Headers sent with every request to the MCP server (JSON object).
# Use this for authentication or any other required headers.
# Examples:
#   MCP_HEADERS={"Authorization": "Bearer your-token"}
#   MCP_HEADERS={"X-Api-Key": "abc123", "X-Tenant": "my-org"}
MCP_HEADERS={"Authorization": "Bearer your-token"}

# Optional: URL to hit as a health check before starting the agent.
# The same MCP_HEADERS are sent with this request.
# If the check fails, the app will refuse to start.
MCP_HEALTH_URL=https://myhost:8080/health

# Required: Azure OpenAI credentials
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=your-deployment-name   # e.g. gpt-4o

# Optional: Azure OpenAI API version (default: 2024-12-01-preview)
AZURE_OPENAI_API_VERSION=2024-12-01-preview
